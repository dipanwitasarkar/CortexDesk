# LLM Configuration (Choose one)
# Option 1: Local gpt2 + sentence-transformers (default, free, full RAG)
LLM_ENDPOINT=local
LLM_API_KEY=
LLM_MODEL=gpt2
LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Option 2: Groq (free, fast, better quality)
# LLM_ENDPOINT=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-api-key
# LLM_MODEL=llama-3.1-8b-instant
# LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Option 3: RunPod (paid, excellent quality)
# LLM_ENDPOINT=https://api.runpod.ai/v2
# LLM_API_KEY=your-runpod-api-key
# LLM_MODEL=qwen-32b-chat
# LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_assistant
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ai_assistant_memory

# Application Configuration
APP_NAME=CortexDesk
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# MCP Configuration
MCP_SERVER_TIMEOUT=30
MCP_MAX_RETRIES=3

# Agent Configuration
AGENT_TIMEOUT=120
MAX_CONCURRENT_AGENTS=5

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
